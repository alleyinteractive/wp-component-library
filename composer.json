{
  "name": "alleyinteractive/wp-component-library",
  "description": "WP Component Library",
  "license": "GPL-2.0-or-later",
  "type": "wordpress-plugin",
  "authors": [
    {
      "name": "Alley Interactive",
      "email": "info@alley.com"
    }
  ],
  "require": {
    "php": "^8.3",
    "league/commonmark": "^2.0",
    "mantle-framework/support": "^1.14",
    "paquettg/php-html-parser": "^3.1",
    "scrivo/highlight.php": "^9.18"
  },
  "require-dev": {
    "alleyinteractive/alley-coding-standards": "^2.0",
    "mantle-framework/testkit": "^1.16"
  },
  "autoload": {
    "classmap": [
      "inc/"
    ]
  },
  "config": {
    "allow-plugins": {
      "alleyinteractive/composer-wordpress-autoloader": true,
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "scripts": {
    "phpcbf": "phpcbf .",
    "phpcs": "phpcs . --runtime-set text_domain wp-component-library",
    "phpunit": "phpunit",
    "test": [
      "@phpcs",
      "@phpunit"
    ]
  }
}
